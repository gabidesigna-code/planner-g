# Copie este arquivo para .env.local e preencha com os valores do SEU projeto Supabase
# (Painel do Supabase > Project Settings > API).
#
# Estas variáveis são SECRETAS e usadas só pelo servidor do Next.js. Elas NÃO têm o prefixo
# NEXT_PUBLIC_ de propósito: nunca vão para o navegador. Não as coloque em nenhum arquivo versionado.

# Project URL
SUPABASE_URL=

# Chave "service_role" (ou "secret", nas chaves novas do Supabase). Ignora o RLS: guarde em segredo.
SUPABASE_SERVICE_ROLE_KEY=
