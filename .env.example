# Copie este arquivo para .env.local e preencha com os valores do SEU projeto Supabase
# (Painel do Supabase > Project Settings > API).

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Chave PÚBLICA (anon / publishable). É segura para o navegador: sozinha não acessa nada, porque o RLS do banco
# limita cada conta aos próprios dados. NÃO use aqui a chave service_role (ela ignora o RLS e o app não precisa dela).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA (Gemini): a ori. Chave em https://aistudio.google.com/apikey. Fica SÓ no servidor (sem NEXT_PUBLIC_).
GEMINI_API_KEY=
# Opcional: troca o modelo sem mexer no código (padrão: gemini-3.5-flash-lite)
# GEMINI_MODEL=

# Só para `npm run test:live` (cria e apaga 2 contas de teste). O app NÃO usa esta chave: deixe fora da Vercel.
# SUPABASE_SERVICE_ROLE_KEY=

# Notificações (Web Push). Gere as chaves UMA vez, no seu computador: npx web-push generate-vapid-keys
# A pública vai para o navegador; a PRIVADA fica só no servidor (nunca com NEXT_PUBLIC_).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
# Segredo que o agendador do Supabase usa para chamar /api/push/send (qualquer texto longo e aleatório).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# O MESMO valor vai em private.app_config (push_secret) no Supabase.
PUSH_CRON_SECRET=
