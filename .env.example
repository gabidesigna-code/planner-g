# Copie este arquivo para .env.local e preencha com os valores do SEU projeto Supabase
# (Painel do Supabase > Project Settings > API).

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Chave PÚBLICA (anon / publishable). É segura para o navegador: sozinha não acessa nada, porque o RLS do banco
# limita cada conta aos próprios dados. NÃO use aqui a chave service_role (ela ignora o RLS e o app não precisa dela).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA (Gemini): a ori. Chave em https://aistudio.google.com/apikey. Fica SÓ no servidor (sem NEXT_PUBLIC_).
GEMINI_API_KEY=
# Opcional: troca o modelo sem mexer no código (padrão: gemini-3.5-flash-lite)
# GEMINI_MODEL=

# Só para `npm run test:live` (cria e apaga 2 contas de teste). O app NÃO usa esta chave: deixe fora da Vercel.
# SUPABASE_SERVICE_ROLE_KEY=
